{
  "extends": [
    "config:recommended",
    ":pinOnlyDevDependencies",
    "group:allNonMajor"
  ],
  "timezone": "Asia/Taipei",
  "rangeStrategy": "bump",
  "rebaseLabel": "rebase",
  "rebaseWhen": "auto",
  "schedule": [
    "before 6am on the first day of the month"
  ],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "matchDepTypes": [
        "devDependencies"
      ],
      "automerge": true
    }
  ]
}
