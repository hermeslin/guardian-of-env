{
  "name": "guardian-of-env",
  "version": "2.0.0",
  "description": "ensure .env files are all the same",
  "type": "module",
  "repository": "https://github.com/hermeslin/guardian-of-env.git",
  "author": "hermeslin <mercury.iwork@gmail.com>",
  "contributors": [
    "Peng-Jie <bivinity.pengzjie@gmail.com>"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "keywords": [
    "guardian",
    "env",
    ".env",
    "environment",
    "config",
    "settings"
  ],
  "scripts": {
    "clean": "rimraf dist coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage"
  },
  "bin": {
    "guardian-of-env": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "dotenv": "^18.0.10",
    "table": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "rimraf": "3.0.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  }
}
