{
  "name": "guardian-of-env",
  "version": "1.2.8",
  "description": "ensure .env files are all the same",
  "type": "module",
  "main": "./dist/main.js",
  "repository": "https://github.com/hermeslin/guardian-of-env.git",
  "author": "hermeslin <mercury.iwork@gmail.com>",
  "contributors": [
    "Peng-Jie <bivinity.pengzjie@gmail.com>"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "keywords": [
    "guardian",
    "env",
    ".env",
    "environment",
    "config",
    "settings"
  ],
  "scripts": {
    "clean": "rimraf dist coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json"
  },
  "bin": {
    "guardian-of-env": "./dist/main.js"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "git add"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm test"
    }
  },
  "dependencies": {
    "diff": "^5.2.2",
    "dotenv": "^18.0.10",
    "lodash.isequal": "^4.5.0",
    "table": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/diff": "5.2.3",
    "@types/lodash.isequal": "4.5.8",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "7.0.2",
    "lint-staged": "11.2.3",
    "pre-commit": "1.2.2",
    "prettier": "3.10.1",
    "rimraf": "3.0.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  }
}
