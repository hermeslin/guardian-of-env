{
  "name": "guardian-of-env",
  "version": "1.2.8",
  "description": "ensure .env files are all the same",
  "main": "./lib/main.js",
  "repository": "https://github.com/hermeslin/guardian-of-env.git",
  "author": "hermeslin <mercury.iwork@gmail.com>",
  "contributors": [
    "Peng-Jie <bivinity.pengzjie@gmail.com>"
  ],
  "engines": {
    "node": ">= 10"
  },
  "license": "MIT",
  "keywords": [
    "guardian",
    "env",
    ".env",
    "environment",
    "config",
    "settings"
  ],
  "scripts": {
    "clean": "rimraf lib coverage",
    "lint": "eslint ./src/**",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "babel src --out-dir lib"
  },
  "bin": {
    "guardian-of-env": "./lib/main.js"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "git add"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm test"
    }
  },
  "dependencies": {
    "diff": "^5.2.2",
    "dotenv": "^10.0.0",
    "lodash.isequal": "^4.5.0",
    "table": "^6.0.0"
  },
  "devDependencies": {
    "@babel/cli": "7.29.7",
    "@babel/core": "7.29.13",
    "@babel/eslint-parser": "7.29.13",
    "@babel/preset-env": "7.29.14",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "7.32.0",
    "eslint-config-airbnb-base": "14.2.1",
    "eslint-plugin-import": "2.32.0",
    "husky": "7.0.2",
    "lint-staged": "11.2.3",
    "pre-commit": "1.2.2",
    "rimraf": "3.0.2",
    "vitest": "5.1.1"
  }
}
